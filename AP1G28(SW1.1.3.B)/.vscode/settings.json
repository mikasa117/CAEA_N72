{
    "cmake.configureArgs": [
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/gcc.cmake",
        "-DARM_CPU=cortex-m33",
        "-DDEVICE_NAME=YTM32B1ME0",
        "-DTOOLCHAIN=GCC"
    ],
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.buildToolArgs": [],
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.generator": "Ninja",
    "cmake.configureOnOpen": false,
    "cmake.ignoreKitEnv": true,
    "cmake.showSystemKits": false,
    "cmake.enableAutomaticKitScan": false,
    "cmake.enabledOutputParsers": [
        "cmake",
        "gcc",
        "gnuld",
        "msvc",
        "ghs",
        "diab",
        "iar"
    ],
    "files.associations": {
        "random": "c",
        "streambuf": "c",
        "type_traits": "c",
        "interrupt_manager.h": "c",
        "std_mcuif.h": "c",
        "mcal_app.h": "c"
    },
    "search.useGlobalIgnoreFiles": true
}