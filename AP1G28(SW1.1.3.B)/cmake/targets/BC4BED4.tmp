    ${PROJ_DIR}/rtos/osif
    ${PROJ_DIR}/Include
    ${PROJ_DIR}/Sources/BSW/MOUDLE/STD_Common/STD_Crc
    ${PROJ_DIR}/Sources/BSW/MOUDLE/STD_Common/STD_Lib
    ${PROJ_DIR}/Sources/BSW/MOUDLE/MCAL_IF
